# Frontend (Next.js) -- read by src/lib/apiClient.ts
# Local dev: leave unset, it defaults to http://localhost:8000
# Production: the deployed backend's URL, e.g. https://nssf-pdf-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend (FastAPI) -- read by backend/app/core/config.py
# Comma-separated list of frontend origins allowed to call this backend.
# Local dev default (used automatically if unset): http://localhost:3000,http://127.0.0.1:3000
# Production: the deployed frontend's actual Vercel URL
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Optional backend tuning (all have working defaults -- only set these if you need to
# change them; see backend/app/core/config.py for the full list)
# NSSF_MAX_UPLOAD_MB=200
# NSSF_MAX_PAGES=2000
# NSSF_ENGINE_TIMEOUT_SECONDS=300
