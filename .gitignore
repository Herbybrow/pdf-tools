# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the checked-in template documenting what variables exist -- has no real values
!.env.example

# vercel
.vercel

# local Claude Code tool settings (per-user permission grants, not project config)
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# python / backend
backend/venv/
venv/
.venv/
# OCR language packs, fetched by backend/scripts/install-deps.ps1 (not first-party assets)
backend/tessdata/
backend/__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/
backend/tmp/
backend/*.log
*.log
*.log.err
*.err

# OS junk
Thumbs.db
desktop.ini

# orchestration script output
suite-frontend.log*
backend/suite-backend.log*

# scratch / generated test output (sample PDFs, diffs, intermediate files -- none
# should be intentionally committed; this project has no first-party sample assets)
*.tmp
*.bak
/scratch/
/tmp/

# generated: postinstall (scripts/copy-pdf-worker.mjs) recreates this from node_modules
/public/pdf.worker.min.mjs
# generated: repomix output (full-codebase dump), not a source artifact
repomix-output.xml

.claude/
repomix-output.xml
*.log
*.log.err

.claude/
.cursor/
repomix-output.xml
*.log
*.log.err


.claude/
.cursor/
repomix-output.xml
*.log
*.log.err

